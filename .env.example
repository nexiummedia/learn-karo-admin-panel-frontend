# ==============================================================================
# Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Rule of Thumb:
# - NEXT_PUBLIC_* variables are exposed to the browser.
# - Non-prefixed variables are SERVER-ONLY and never exposed to the client bundle.
# ==============================================================================

# Public API Base URL used by the native Fetch client (Client & Server)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Application Environment ('development' | 'test' | 'production')
NEXT_PUBLIC_APP_ENV=development

# Optional: Server-only secrets (DO NOT PREFIX WITH NEXT_PUBLIC)
# API_SECRET_KEY=your-private-secret-key-here

